# Copy to .env and fill in the blank values before the first application start.
# Database connection used by Docker Compose and Spring.
POSTGRES_DB=sentra_inventory
POSTGRES_USER=sentra
POSTGRES_PASSWORD=

# First application administrator, created only when no employees exist.
# Swagger username is this email, NOT POSTGRES_USER.
# Password: 12-72 characters, at most 72 UTF-8 bytes.
# Spring does not generate or log a default password.
SENTRA_ADMIN_EMAIL=
SENTRA_ADMIN_PASSWORD=
